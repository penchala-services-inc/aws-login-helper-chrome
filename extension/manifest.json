{
  "manifest_version": 3,
  "name": "AWS Login Helper",
  "description": "Log into AWS IAM Identity Center once, open any account/role in its own isolated Chrome profile window without re-authenticating.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/penchala-services-inc/aws-login-helper-chrome",
  "author": "Penchala Services Inc",
  
  "permissions": ["cookies", "storage", "tabs", "nativeMessaging", "alarms"],
  "host_permissions": [
    "*://*.awsapps.com/*",
    "*://*.console.aws.amazon.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.awsapps.com/*", "*://*.console.aws.amazon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "options.html",
    "default_title": "AWS Login Helper",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
